{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (React)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && BROWSER=none PORT=3001 yarn start"],
      "port": 3001
    },
    {
      "name": "Backend (Express/nodemon)",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "cwd": "backend",
      "port": 5000
    }
  ]
}
