# JWT Configuration
JWT_SECRET=honeyspice_secure_jwt_secret_key_2024

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/honeyspicecuisine

# Frontend URL
FRONTEND_URL=http://localhost:3000

# SMTP Configuration (using Gmail as example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
